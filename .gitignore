# API Reference pages, generated from openapi.json by `npm run gen:api` (runs before dev/build)
/content/docs/api/*
!/content/docs/api/openapi.json
# ...except the tag folders' intro pages (<tag>/index.mdx); the overview is scripts/api-overview.mdx
!/content/docs/api/*/
/content/docs/api/*/*
!/content/docs/api/*/index.mdx

# SDK Reference: content generated by `npm run gen:sdk` from the versions pinned in
# scripts/sdk-docs/package.json, and the separate static build of it (see scripts/build-sdk.mjs)
/content/sdk/
/scripts/sdk-docs/node_modules/
/.source-sdk/
